void AddnewDrone()
{
    system("cls");
    if ((int)dronesVec.size() >= MAX_DRONES)
    {
        cout << "No existe espacio para dar de alta un nuevo dron (" << MAX_DRONES << ").\n";
        system("pause");
        return;
    }

    drone d;
    d.droneID = nextDroneID++;
    d.id = d.droneID;

    cout << "\n=== Ingreso de un nuevo dron al sistema ===\n";
    cout << "ID: " << d.droneID << "\n";
    
    cout << "Modelo: ";
    getline(cin, d.modelname);

    cout << "Carga maxima que puede sacar el dron (kg): ";
    cin >> d.maxPayload;
    cin.ignore();

    d.cargaMax = d.maxPayload;

    if (d.maxPayload >= 1 && d.maxPayload <= 5) d.classd = 'C';
    else if (d.maxPayload >= 6 && d.maxPayload <= 15) d.classd = 'M';
    else if (d.maxPayload >= 16) d.classd = 'G';
    else
    {
        cout << "Carga del dron no válida.\n";
        system("pause");
        return;
    }

    
    d.velocidad = 50.0;
    d.speed = d.velocidad / 3.6;
    d.state = false;
    d.disponible = true;

    dronesVec.push_back(d);

    cout << "\nDron agregado exitosamente.\n";
    system("pause");
}


void ManagePackages()
{
    system("cls");
    cout << "\n=== Gestion de paquetes ===\n";
    cout << "1. Crear nuevo paquete\n";
    cout << "2. Modificar paquete (primeros 4 minutos)\n";
    cout << "3. Eliminar paquete (primeros 4 minutos)\n";
    cout << "4. Volver al menú principal\n";
    cout << "Selecciona una opción: ";
    
    char opt;
    if (!cin.get(opt)) return;
    cin.ignore();

    switch (opt)
    {
        case '1':
            CreatePackage(packagesHead, packagesTail);
            break;
        case '2':
            ModifyPackage(packagesHead, packagesTail);
            break;
        case '3':
        {
            cout << "Ingresa el número de orden a eliminar: ";
            int ordernum; cin >> ordernum; cin.ignore();
            deletePackage(packagesHead, packagesTail, ordernum);
            break;
        }
        case '4':
            return;
        default:
