    int id;             
    double maxPayload;  
    double cargaMax;    
    double velocidad;   
    double speed;       
    bool state;         
    bool disponible;    
    char classd;
    string modelname;
};

struct Package
{
    int ordernumber;              
    int id;                        
    double weight;                 
    double peso;                   
    string destination;
    int xDestino = 0;             
    int yDestino = 0;
    string status;
    string description;
    Clock::time_point creationTime;
    time_t horaSalida = 0;
    time_t horaLlegada = 0;
    bool entregado = false;
    int dronAsignado = -1;
};


struct Node
{
