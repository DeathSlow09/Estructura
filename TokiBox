            break;
    }
    system("pause");
}


int GetPackageAgeInSeconds(const Package* pkg)
{
    auto now = Clock::now();
    auto duration = chrono::duration_cast<chrono::seconds>(now - pkg->creationTime);
    return static_cast<int>(duration.count());
}


void CreatePackage(Node*& head, Node*& tail)
{
    Package* newPackage = new Package;
    newPackage->ordernumber = nextOrderNumber++;
    newPackage->id = newPackage->ordernumber;
    newPackage->creationTime = Clock::now();
    newPackage->horaSalida = 0;
    newPackage->horaLlegada = 0;
    newPackage->entregado = false;
    newPackage->dronAsignado = -1;

    cout << "\n=== Crear nuevo paquete ===\n";
    cout << "Número de orden asignado automaticamente: " << newPackage->ordernumber << "\n";
    
    cout << "Peso del paquete (kg): ";
    cin >> newPackage->weight; newPackage->peso = newPackage->weight;
    cin.ignore();

    cout << "Destino (texto): ";
    getline(cin, newPackage->destination);

    cout << "Descripción: ";
    getline(cin, newPackage->description);

    newPackage->status = "pendiente";

    Node* newNode = new Node;
    newNode->PackageData = newPackage;
    newNode->next = nullptr;
    newNode->prev = nullptr;

    if (head == nullptr)
    {
        head = tail = newNode;
    }
    else
    {
        tail->next = newNode;
        newNode->prev = tail;
        tail = newNode;
    }

    
    paquetesVec.push_back(*newPackage);

    cout << "\nPaquete creado exitosamente.\n";
}


void ModifyPackage(Node*& head, Node*& tail)
{
    cout << "\n=== Modificar paquete ===\n";
    cout << "Ingresa el número de orden a modificar: ";
    int ordernum; cin >> ordernum; cin.ignore();

    Node* current = head;
    while (current != nullptr)
    {
        if (current->PackageData->ordernumber == ordernum)
        {
            int ageSeconds = GetPackageAgeInSeconds(current->PackageData);
            if (ageSeconds > 240)
            {
                cout << "\nNo se puede modificar este paquete. Han pasado más de 4 minutos desde su creación.\n";
                return;
            }
            if (ageSeconds > 120)
            {
                cout << "\nAdvertencia: Este paquete será enviado en los próximos 2 minutos.\n";
            }

            cout << "\nDatos actuales del paquete:\n";
            cout << "Peso: " << current->PackageData->weight << " kg\n";
            cout << "Destino: " << current->PackageData->destination << "\n";
            cout << "Descripción: " << current->PackageData->description << "\n";
            cout << "Estado: " << current->PackageData->status << "\n";

            cout << "\n¿Qué deseas modificar?\n";
            cout << "1. Peso\n2. Destino\n3. Descripción\n4. Estado\n5. Cancelar\nSelecciona: ";
            char opt; if (!cin.get(opt)) return; cin.ignore();

            switch (opt)
            {
                case '1':
                    cout << "Nuevo peso (kg): ";
                    cin >> current->PackageData->weight; current->PackageData->peso = current->PackageData->weight; cin.ignore();
                    cout << "Peso actualizado.\n";
                    break;
                case '2':
                    cout << "Nuevo destino: ";
                    getline(cin, current->PackageData->destination);
                    cout << "Destino actualizado.\n";
                    break;
                case '3':
                    cout << "Nueva descripción: ";
                    getline(cin, current->PackageData->description);
                    cout << "Descripción actualizada.\n";
                    break;
                case '4':
                    cout << "Nuevo estado: ";
                    getline(cin, current->PackageData->status);
                    current->PackageData->entregado = (current->PackageData->status == "entregado");
                    cout << "Estado actualizado.\n";
                    break;
                case '5':
                    cout << "Operación cancelada.\n";
                    break;
                default:
                    cout << "Opción inválida.\n";
                    break;
            }

            // actualizar vector espejo (buscar por id)
            for (auto &p : paquetesVec)
            {
                if (p.id == current->PackageData->ordernumber)
                {
                    p = *current->PackageData;
                    break;
                }
            }

            return;
        }
        current = current->next;
    }

    cout << "Paquete con orden " << ordernum << " no encontrado.\n";
}


void deletePackage(Node*& head, Node*& tail, int ordernum)
{
    Node* current = head;
    while (current != nullptr)
    {
        if (current->PackageData->ordernumber == ordernum)
        {
            int ageSeconds = GetPackageAgeInSeconds(current->PackageData);
            if (ageSeconds > 240)
            {
                cout << "No se puede eliminar este paquete. Han pasado más de 4 minutos.\n";
                return;
            }
            if (ageSeconds > 120)
            {
                cout << "Advertencia: Este paquete será enviado en los próximos 2 minutos.\n";
            }

            if (current->prev) current->prev->next = current->next; else head = current->next;
            if (current->next) current->next->prev = current->prev; else tail = current->prev;

            // borrar del vector espejo
            for (auto it = paquetesVec.begin(); it != paquetesVec.end(); ++it)
            {
                if (it->id == ordernum) { paquetesVec.erase(it); break; }
            }

            delete current->PackageData;
            delete current;

            cout << "Paquete eliminado exitosamente.\n";
            return;
        }
        current = current->next;
    }
    cout << "Paquete con orden " << ordernum << " no encontrado.\n";
}


void readPackages(Node* head)
{
   
    listadoPaquetes(paquetesVec);
}


void LiberarPackages(Node*& head, Node*& tail)
{
    while (head)
    {
        Node* tmp = head;
        head = head->next;
        delete tmp->PackageData;
        delete tmp;
    }
    tail = nullptr;
    paquetesVec.clear();
}


