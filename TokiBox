vector<drone> dronesVec;
const int MAX_DRONES = 50;
int nextDroneID = 1;

Node* packagesHead = nullptr;
Node* packagesTail = nullptr;
vector<Package> paquetesVec; 
int nextOrderNumber = 1;


int main()
{
    setlocale(LC_ALL, "es_MX.UTF-8");
