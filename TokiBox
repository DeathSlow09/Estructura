         << "|" << setw(10) << "ID"
         << "|" << setw(10) << "Peso(kg)"
         << "|" << setw(12) << "X Dest"
         << "|" << setw(12) << "Y Dest"
         << "|" << setw(12) << "Estado"
         << "|" << setw(12) << "Hora Salida"
         << "|" << setw(12) << "Hora Llegada" << "|\n";
    cout << setfill('-') << setw(120) << "" << "\n";

    const time_t ahora = time(nullptr);

    for (size_t i = 0; i < paquetes.size(); i++) {
        const Package& p = paquetes[i];
        const string estado = estadoPaquete(p);
        const string horaSalidaStr = formatoTiempo(p.horaSalida);
        const string horaLlegadaStr = horaLlegadaTexto(p, dronesVec, ahora);

